# Required
XAI_API_KEY=
DISCORD_TOKEN=

# Model (default grok-4.6). Set a cheaper id if you want.
GROK_MODEL=grok-4.6

# Comma-separated guild snowflakes. Empty refuses every guild.
DISCORD_GUILD_IDS=

# Optional. Empty allows every user in an allowed guild.
DISCORD_ALLOW_USER_IDS=

# Last N stored messages per channel or thread (user and assistant each count).
FACET_HISTORY=12

# 1: reply in threads the bot has already joined, without a mention.
FACET_THREAD_AUTO=0

# Optional path to a UTF-8 file that replaces the built-in system prompt.
FACET_SYSTEM_PROMPT=
